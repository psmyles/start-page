{
  "manifest_version": 3,
  "name": "My Startpage",
  "version": "4.1",
  "description": "Loads my personal startpage from GitHub.",
  "icons": {
    "48": "icon.png"
  },
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "host_permissions": [
    "https://psmyles.github.io/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "{67788975-7308-472b-bc17-b99e4330ed8f}",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
